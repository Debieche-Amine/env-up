#!/usr/bin/env bash

set -o pipefail

FLAKE_PATH="$HOME/nixos"
FLAKE_TARGET="$(hostname)"
TIMESTAMP=$(date +"%Y%m%d-%H%M%S")

echo
echo "What do you want to do now?"
echo "1) nh os switch"
echo "2) nh os test"
echo "3) nixos-rebuild switch"
echo "4) nixos-rebuild test"

read -rp "Choose [1-4]: " choice

# Switch to the flake directory early so alejandra and git operate on the right files
cd "$FLAKE_PATH" || exit 1

alejandra .

git add -A
git diff --staged

# Check if `nh` is installed and available in the PATH
if command -v nh &>/dev/null; then
        HAS_NH=true
else
        HAS_NH=false
fi

case "$choice" in
1)
        if [ "$HAS_NH" = false ]; then
                echo "Error: 'nh' is not installed."
                exit 1
        fi
        # nh handles privilege escalation internally; no sudo needed
        CMD="nh os switch $FLAKE_PATH --hostname $FLAKE_TARGET"
        COMMIT_AFTER_BUILD=true
        ;;
2)
        if [ "$HAS_NH" = false ]; then
                echo "Error: 'nh' is not installed."
                exit 1
        fi
        CMD="nh os test $FLAKE_PATH --hostname $FLAKE_TARGET"
        COMMIT_AFTER_BUILD=false
        ;;
3)
        CMD="sudo nixos-rebuild switch --flake $FLAKE_PATH#$FLAKE_TARGET"
        COMMIT_AFTER_BUILD=true
        ;;
4)
        CMD="sudo nixos-rebuild test --flake $FLAKE_PATH#$FLAKE_TARGET"
        COMMIT_AFTER_BUILD=false
        ;;
*)
        echo "Invalid choice."
        exit 1
        ;;
esac

echo
echo "Running: $CMD"
echo

# Execute the command directly so the terminal UI (like nom) is preserved
if $CMD; then
        echo
        echo "Build succeeded."

        if [ "$COMMIT_AFTER_BUILD" = true ]; then
                echo "Committing changes..."

                # Only commit if there are changes
                if ! git diff --cached --quiet; then
                        git commit -m "nixos: ($TIMESTAMP)"
                        echo "Git commit created."
                else
                        echo "No changes to commit."
                fi
        else
                echo "Skipping commit, as this was a 'test' run."
        fi
else
        echo
        echo "Build failed."
fi
